# Cloud API keys (only needed if you re-enable cloud models in config.yaml)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-...

# Local model (llama-server): no API key required.
#   llama-server -m /path/to/your-model.gguf
# The benchmark connects to http://127.0.0.1:8080/v1 (see benchmark/config.yaml).
